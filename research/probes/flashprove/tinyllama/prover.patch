+inline Constants constants(uint64_t d, uint64_t dh) {
+  if (d == 5120 && dh == 128) return {0x3F8F1BBDu, 0x3DCA62C2u};
+  if (d == 2048 && dh == 64) return {0x3FB504F3u, 0x3E3504F3u};
+  return {};
+}
